[push]
	default = current
	autoSetupRemote = true

[core]
  pager = delta
  ignorecase = false

[interactive]
  diffFilter = delta

[delta]
  navigate = true  # use n and N to move between diff sections
  syntax-theme = ansi
  tabs = 2
  diff-so-fancy = false
[delta "light"]
  light = true
[delta "dark"]
  dark = true

[merge]
	conflictstyle = diff3

[diff]
  colorMoved = default

[pull]
	rebase = true

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[init]
	defaultBranch = main

[advice]
	addIgnoredFile = false

[include]
  path = ~/.config/git/private/.gitconfig

# NOTE: this generic block MUST stay ABOVE the per-host [credential "https://…"]
# blocks below. `helper =` resets the whole accumulated helper list, and git reads
# config in FILE ORDER — with this block last, its reset wiped the github-specific
# `gh auth git-credential` helper, so GCM (.NET, ~0.3s/call) answered every GitHub
# request instead. Reordering cut `git push` from ~2.1s to ~1.5s.
[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[diff "lockb"]
	textconv = bun
	binary = true
[submodule]
	recurse = true
